---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { url } from "../../lib/graph";
export async function getStaticPaths() {
  const entries = (await getCollection("log")).sort((a, b) => a.id.localeCompare(b.id));
  return entries.map((e, i) => ({ params: { id: e.id }, props: { e, prev: entries[i - 1], next: entries[i + 1] } }));
}
const { e, prev, next } = Astro.props;
const { Content } = await render(e);
const t = (x: any) => (x.body.match(/^# (.+)$/m)?.[1] ?? x.id);
---
<Base title={t(e)}>
  <p><a href={url("log/")}>Research log</a></p>
  <article class="prose"><Content /></article>
  <nav class="pager" aria-label="Log entries">
    {prev && <a href={url(`log/${prev.id}/`)}>Previous: {t(prev)}</a>}
    {next && <a href={url(`log/${next.id}/`)}>Next: {t(next)}</a>}
  </nav>
</Base>
<style>
  .pager { display: flex; flex-direction: column; gap: .5rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--ink); }
</style>
