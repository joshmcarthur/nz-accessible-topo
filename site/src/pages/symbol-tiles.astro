---
import Base from "../layouts/Base.astro";
import { url } from "../lib/graph";
import table from "../data/symbol-tiles.json";
import conditions from "../data/conditions.json";

const floors = table.floors;
const conditionName: Record<string, string> = {
  ...Object.fromEntries(conditions.map((c) => [c.id, c.name])),
  acuity: "Reduced acuity (6/18)",
};
const sceneName: Record<string, string> = {
  paper: "Paper",
  native: "Native forest",
  exotic: "Exotic forest",
  scrub: "Scrub",
  scattered: "Scattered scrub",
  water: "Water",
  urban: "Urban",
  sand: "Sand",
  swamp: "Swamp",
  ice: "Ice",
  contours: "Contours across",
  grid: "Grid line across",
  stream: "Stream across",
  road: "Road across",
  name: "Name across",
};
const failing = (row: any) => row.scenes.filter((s: any) => s.fails.length).length;
const rows = [...table.symbols].sort((a: any, b: any) => failing(b) - failing(a));
const tiles = rows.reduce((n: number, row: any) => n + row.scenes.length, 0);
const failed = rows.reduce((n: number, row: any) => n + failing(row), 0);
const percent = (v: number) => `${Math.round(v * 100)}%`;
---
<Base title="Symbol test tiles" current="symbols/">
  <h1>Symbol test tiles</h1>
  <p class="lede">Each legend symbol, drawn by the accessible map style on every fill it can sit on, and with another map class across it. Each tile is 10 mm of the printed sheet.</p>
  <p>{rows.length} symbols and {tiles} tiles. {failed} tiles fail in one vision condition or more. Symbols with the most failing tiles are first.</p>
  <p>A part of the symbol counts as visible when it still differs from the ground just outside the symbol: {floors.contrast}:1 contrast for greyscale and red light (R-01), and a colour difference of {floors.delta_e} (CIEDE2000) for typical colour vision and the three colour vision deficiencies. Reduced acuity is typical colour vision through a blur as wide as the detail a 6/18 eye resolves at 400 mm, about 0.35 mm on the sheet (F-32). Where another class crosses the symbol, ink from that class does not count. Ink within 0.35 mm of visible ink counts with it, so a dark casing carries its road. A tile fails a condition when less than {percent(floors.visible)} of the symbol stays visible.</p>
  <h2>What is not gated</h2>
  <ul>
    <li>An area fill is shown, not gated, in greyscale, red light and reduced acuity. Only the ink that draws a shape must meet the floors. Lines and points on each fill are gated in their own rows.</li>
    <li>Water and urban fills hide some classes completely. LINZ draws those classes under the fill, and the stock map does the same.</li>
    <li>A road across a point mark. A road does not cross a point mark on the map.</li>
    <li>A name on top of a point mark. The name wins: its 0.4 mm halo keeps the name clear, and a thinner halo let the mark run into the letters. A name across a line is gated.</li>
    <li>Intermediate and supplementary contours. The 20 m mesh is recessive by design (log 0054).</li>
  </ul>
  <p class="note">Data: <code>tools/render_symbol_tiles.py</code> and <code>tools/export_symbol_tiles.py</code>. Our own measurement, evidence grade D.</p>
  <p><a href={url("symbols/")}>Back to the symbol definitions</a>.</p>

  {rows.map((row: any) => (
    <section class="wide">
      <h2 id={row.key}>{row.label}</h2>
      <div class="table-wrap" tabindex="0" role="region" aria-label={`${row.label} test tiles`}>
        <table style={`min-width: ${row.scenes.length * 5.5}rem`}>
          <caption>{row.label}: {failing(row)} of {row.scenes.length} tiles fail.{row.gated.length < table.conditions.length ? " Area fill: gated on colour vision only." : ""}</caption>
          <thead>
            <tr>{row.scenes.map((s: any) => <th scope="col">{sceneName[s.scene]}</th>)}</tr>
          </thead>
          <tbody>
            <tr>
              <td class="strip" colspan={row.scenes.length}>
                <img src={url(`symbol-tiles/${row.key}.png`)} alt={`${row.label} drawn on: ${row.scenes.map((s: any) => sceneName[s.scene]).join(", ")}`} width={row.scenes.length * 236} height="236" loading="lazy" />
              </td>
            </tr>
            <tr>
              {row.scenes.map((s: any) => (
                <td>
                  {s.exception
                    ? <>
                        <span class="verdict">Not gated</span>
                        <p class="why">{s.exception}</p>
                      </>
                    : s.fails.length
                      ? <>
                          <span class="verdict fail">Fail</span>
                          <ul class="checks">{s.fails.map((c: string) => <li>{conditionName[c]}: {percent(s.visible[c])}</li>)}</ul>
                        </>
                      : <span class="verdict pass">Pass</span>}
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  ))}
</Base>
<style>
  caption { text-align: left; font-weight: 700; margin-bottom: .75rem; }
  table { width: 100%; table-layout: fixed; }
  th, td { vertical-align: top; font-size: .85rem; padding: .25rem; }
  td.strip { padding: 0; }
  img { display: block; width: 100%; height: auto; border: 1px solid var(--ink); background: #fff; }
  .checks { margin: .25rem 0 0; padding-left: 1rem; }
  .why { margin: .25rem 0 0; }
  .verdict { font-weight: 700; }
  .verdict.fail::before, .verdict.pass::before {
    content: "";
    display: inline-block;
    width: .7rem;
    height: .7rem;
    margin-right: .4rem;
    border: 2px solid var(--ink);
    vertical-align: -0.1rem;
  }
  .verdict.fail::before { background: var(--ink); }
  .verdict.pass::before { background: var(--paper); }
</style>
