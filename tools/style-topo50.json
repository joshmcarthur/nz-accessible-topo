    "church": {
      "marker": "./symbol/nztopo50_church.svg",
      "size_mm": 0.5,
      "stroke_mm": 0.15,
      "bar_stroke_mm": 0.15
    },
    "shipwreck": {
      "marker": "./symbol/nztopo50_wreck_ship.svg",
      "size_mm": 3.0,
      "stroke_mm": 0.15
    },
    "tower": {
      "marker": "./symbol/nztopo50_tower.svg",
      "size_mm": 1.6,
      "stroke_mm": 0.15
    },
    "redoubt": {
      "marker": "./symbol/nztopo50_redoubt.svg",
      "size_mm": 2.5,
      "stroke_mm": 0.15
    },
    "mast": {
      "marker": "./symbol/nztopo50_mast.svg",
      "size_mm": 1.76226,
      "stroke_mm": 0.15
    },
    "beacon": {
      "marker": "./symbol/nztopo50_marine_beacon.svg",
      "size_mm": 2.0,
      "stroke_mm": 0.15
    },
    "buried_gas_pipeline": {
      "colour": "#951600",
      "width_mm": 0.25,
      "dash": "2;0.5"
    }
  },
  "water": {
    "stream_width_mm": 0.35,
    "drain_width_mm": 0.15
  },
  "hillshade": {
    "painted": true,
    "raster_file": "dem.tif",
    "azimuth_deg": 337.5,
    "altitude_deg": 45,
    "multidirectional": true,
    "z_factor": 1,
    "fill_azimuths_deg": [292.5, 22.5]
  }
