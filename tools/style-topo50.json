{
  "fonts": {
    "raster_family": "Atkinson Hyperlegible Next Macron",
    "raster_upright_style": "Regular",
    "raster_natural_style": "Regular",
    "stock_family": "Nimbus Sans LINZ",
    "vector_family": "Open Sans"
  },
  "labels": {
    "size_floor_pt": 7,
    "spot_height_floor_pt": 6,
    "spot_height_layer_contains": "relief_point",
    "natural_colour": "#7A5542",
    "road_abbreviations": {
      "ROAD": "RD",
      "STREET": "ST",
      "AVENUE": "AVE",
      "DRIVE": "DR",
      "TERRACE": "TCE",
      "CRESCENT": "CRES",
      "PLACE": "PL"
    },
    "web_floor_px": 10,
    "place_name_floor_px": 11,
    "letter_spacing_em": 0.05,
    "carto_point": {
      "allowance_mm": 1,
      "advance_em": 0.6,
      "overrun_mm": 0.5,
      "wrap_chars": 16,
      "line_height": 0.85
    },
    "place_hierarchy": [
      {"rank": "suburb-locality", "layers": ["Place-Label-Suburb", "Place-Label-Locality"], "size_px": 11},
      {"rank": "town", "layers": ["Place-Label-Town"], "size_px": 14},
      {"rank": "city", "layers": ["Place-Label-City-14", "Place-Label-City-7"], "size_px": 17}
    ]
  },
  "label_contrast": {
    "min_ratio": 4.8,
    "halo_alpha": 1,
    "halo_max_mm": 0.4,
    "red_light_min": 3.0
  },
  "contours": {
    "index": {"colour": "#7A5542", "width_mm": 0.35, "alpha": 0.85},
    "intermediate": {
      "colour": "#B08872",
      "width_mm": 0.12,
      "casing_colour": "#7A5542",
      "casing_width_mm": 0.2,
      "alpha": 0.5
    },
    "number_halo": {"colour": "#FFFFFF", "width_mm": 0.3}
  },
  "reference_inks": {
    "project_road": "#EC7000",
    "project_highway": "#E31A1C",
    "project_road_casing": "#232323",
    "water_fill": "#D1E7F5",
    "print_legend_highway": "#EA6300",
    "stream": "#004C99",
    "shelterbelt": "#008A00",
    "grid": "#269FD2",
    "urban_fill": "#BCBAB6",
    "island_outline": "#0083BB",
    "vegetation_outline": "#859E3E"
  },
  "vegetation": {
    "native": {
      "colour": "#E1EAC3",
      "alpha": 180,
      "marker": {"colour": "#3F6B32"}
    },
    "exotic": {"colour": "#A4D65E", "alpha": 0.2},
    "scrub": {"colour": "#A3CC90", "alpha": 26},
    "scattered": {"colour": "#E0EDD8", "distance_mm": 5},
    "trees": {
      "marker": "./symbol/nztopo50_tree_stroke.svg",
      "size_mm": 0.2,
      "legend_size_mm": 1.4
    },
    "scrub_dots": {
      "colour": "#6A9A50",
      "marker": "third_arc",
      "size_mm": 1.4,
      "stroke_mm": 0.18,
      "distance_mm": 3
    }
  },
  "sizes": {
    "navigation_line_mm": 0.35,
    "line_floor_mm": 0.15
  },
  "draw_order": [
    {"name": "vegetation map", "below": "contour"}
  ],
  "tracks": {
    "access": {
      "reserved_channel": "casing_colour",
      "painted": false
    },
    "closed_foot": {
      "width_mm": 0.35,
      "open_width_mm": 0.35,
      "closed_dash": "1.75;0.875",
      "open_dash": "1.75;0.875",
      "casing_colour": "#1A1A1A",
      "casing_alpha": 0.55,
      "crossbar_colour": "#000000",
      "crossbar_size_mm": 1.25,
      "crossbar_outline_width_mm": 0.15,
      "crossbar_angle_deg": 0,
      "marker": "cross2",
      "marker_interval_mm": 3
    },
    "vehicle": {
      "width_mm": 0.35,
      "dash": "4.375;0.875"
    },
    "dotted": {
      "colour": "#000000",
      "interval_mm": 1.0,
      "route_dot_mm": 0.45,
      "connector_dot_mm": 0.3
    }
  },
  "springs": {
    "hot": {"glyph": "cross2", "colour": "#141414"},
    "cold": {"glyph": "circle", "colour": "#005C8F"}
  },
  "structures": {
